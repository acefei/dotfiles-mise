#!/usr/bin/env bash
#MISE description="Report skills that are installed twice (Claude plugins, ~/.claude/skills, ~/.agents/skills, Pi packages)"
#MISE wait_for=["setup-agents", "setup-pi"]
set -euo pipefail

# Read-only. Duplicates are judged per agent, because an agent loads only its own folders:
#   claude: ~/.claude/skills and enabled Claude plugins
#   pi:     ~/.agents/skills and Pi packages
# A skill counts once per real folder (a symlink to the same folder is not a duplicate). Two
# different folders with the same skill name for ONE agent are reported. The same skill in
# one folder per agent (a Claude plugin and a Pi copy) is only a note: each agent needs its own.
# Set AUDIT_SKILLS_STRICT=1 to fail on duplicates.

rows=$(mktemp)
trap 'rm -f "$rows" "$rows.names" "$rows.agent" "$rows.notes"' EXIT

hash_file() {
    if command -v sha256sum &>/dev/null; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# The name in the SKILL.md frontmatter, else the folder name.
skill_name() {
    local name
    name=$(awk 'NR == 1 && $0 != "---" { exit }
                NR > 1 && $0 == "---" { exit }
                /^name:/ { sub(/^name:[[:space:]]*/, ""); print; exit }' "$1/SKILL.md" | tr -d "\"'")
    printf '%s' "${name:-$(basename "$1")}"
}

# add_skill <label> <folder>: record one skill folder if it holds a SKILL.md.
add_skill() {
    local label=$1 dir=${2%/} real
    [[ -f "$dir/SKILL.md" ]] || return 0
    real=$(cd "$dir" && pwd -P)
    printf '%s\t%s\t%s\t%s\n' "$label" "$(skill_name "$dir")" "$(hash_file "$dir/SKILL.md")" "$real" >>"$rows"
}

add_children() {
    local label=$1 base=$2 dir
    [[ -d "$base" ]] || return 0
    for dir in "$base"/*/; do
        add_skill "$label" "$dir"
    done
}

# Claude plugins that are enabled. claude plugin list gives the current install folder of each,
# so old cached versions cannot cause a false report. A plugin.json "skills" list wins over
# the default skills/ folder, as in Claude Code.
audit_claude_plugins() {
    if ! command -v claude &>/dev/null || ! command -v jq &>/dev/null; then
        echo "claude or jq not found: Claude plugin skills are not audited"
        return 0
    fi
    local id path manifest skill
    while IFS=$'\t' read -r id path; do
        manifest="$path/.claude-plugin/plugin.json"
        if [[ -f "$manifest" ]] && [[ -n "$(jq -r '.skills[]? // empty' "$manifest")" ]]; then
            while IFS= read -r skill; do
                add_skill "claude-plugin:$id" "$path/${skill#./}"
            done < <(jq -r '.skills[]?' "$manifest")
        else
            add_children "claude-plugin:$id" "$path/skills"
        fi
    done < <(claude plugin list --json 2>/dev/null \
        | jq -r '.[] | select(.enabled == true and ((.installPath // "") != "")) | [.id, .installPath] | @tsv')
}

# Pi packages: pi list prints each package path on an indented line.
audit_pi_packages() {
    command -v pi &>/dev/null || return 0
    local path
    while IFS= read -r path; do
        add_children "pi-package:$(basename "$path")" "$path/skills"
    done < <(pi list </dev/null 2>/dev/null | sed -n 's/^    \(\/.*\)$/\1/p')
}

add_children "claude-skills" "$HOME/.claude/skills"
add_children "agents-skills" "$HOME/.agents/skills"
audit_claude_plugins
audit_pi_packages

total=$(wc -l <"$rows" | tr -d ' ')
folders=$(cut -f4 "$rows" | sort -u | wc -l | tr -d ' ')

# Rows get an agent column, then: same name in two different folders for one agent.
awk -F'\t' 'BEGIN { OFS = "\t" }
    { a = ($1 ~ /^(claude-)/) ? "claude" : "pi"; print $0, a }' "$rows" >"$rows.agent"

sort -t$'\t' -k5,5 -k2,2 -k4,4 "$rows.agent" | awk -F'\t' '
    function flush(   i) {
        if (n > 1) {
            dup++
            printf "DUPLICATE for %s: %s\n", agent, cur
            for (i = 1; i <= n; i++) printf "    %s\n      %s  sha256:%s\n", lab[i], dir[i], substr(h[i], 1, 12)
        }
        n = 0
    }
    {
        key = $5 SUBSEP $2
        if (key != curkey) { flush(); curkey = key; cur = $2; agent = $5 }
        if (n > 0 && dir[n] == $4) lab[n] = lab[n] ", " $1
        else { n++; lab[n] = $1; dir[n] = $4; h[n] = $3 }
    }
    END { flush(); print "SUMMARY " dup + 0 }' >"$rows.names"

# Same name, a different folder per agent: expected, so only a note.
sort -t$'\t' -k2,2 "$rows.agent" | awk -F'\t' '
    function note() { if (nd > 1 && na > 1) printf "NOTE: %s is on disk once per agent (claude and pi each need their own copy)\n", cur }
    $2 != cur { note(); cur = $2; nd = 0; na = 0; sd = ""; sa = "" }
    {
        if (index(sd, "|" $4 "|") == 0) { nd++; sd = sd "|" $4 "|" }
        if (index(sa, "|" $5 "|") == 0) { na++; sa = sa "|" $5 "|" }
    }
    END { note() }' >"$rows.notes"

grep -v '^SUMMARY ' "$rows.names" || true
cat "$rows.notes"
dups=$(awk '/^SUMMARY / { print $2 }' "$rows.names")
echo "Skill audit: $total skill entries in $folders folders, $dups duplicate group(s)"
if [[ "$dups" -gt 0 ]]; then
    echo "Remove one copy: a SKILL_SETS entry in setup-agents, or a plugin in CLAUDE_PLUGINS."
    [[ "${AUDIT_SKILLS_STRICT:-}" == "1" ]] && exit 1
fi
exit 0
