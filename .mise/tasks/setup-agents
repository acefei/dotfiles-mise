#!/usr/bin/env bash
#MISE description="Install and configure the AI coding agents (VSCode, Claude Code, Pi) and their skills, then audit duplicate skills"
#MISE depends=["setup-secrets"]
set -uo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

for part in common vscode claude pi skills audit; do
    source "$MISE_PROJECT_ROOT/lib/agents/$part.sh"
done

failed=()
for step in setup_vscode setup_claude setup_pi setup_skills audit_skills; do
    "$step" || failed+=("$step")
done

if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed steps: ${failed[*]}" >&2
    exit 1
fi
