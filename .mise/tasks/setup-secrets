#!/usr/bin/env bash
#MISE description="Store NVIDIA_API_KEY in the secrets store (sops+age)"
#MISE depends=["setup-utility"]
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

export PATH="$HOME/.local/bin:$PATH"

if [[ "${CI:-}" == "true" || "${CI:-}" == "1" ]]; then
    echo "CI: NVIDIA_API_KEY stays in the environment, it is not stored"
    exit 0
fi

store="${SECRETS_FILE:-$HOME/.config/mise/secrets.json}"
age_key="${SOPS_AGE_KEY_FILE:-$HOME/.config/mise/age.txt}"

terminal=""
if [[ -t 0 ]]; then
    terminal=/dev/stdin
elif (exec </dev/tty) 2>/dev/null; then
    terminal=/dev/tty
fi

key="${NVIDIA_API_KEY:-}"

if [[ -z "$key" && -f "$store" && -f "$age_key" ]] && secrets list 2>/dev/null | grep -qx "NVIDIA_API_KEY"; then
    echo "NVIDIA_API_KEY is already in the secrets store"
    exit 0
fi

if [[ -z "$key" ]]; then
    if [[ -z "$terminal" ]]; then
        echo "No NVIDIA_API_KEY and no terminal to ask on, skipping."
        echo "Run later: mise run setup-secrets"
        exit 0
    fi
    echo "NVIDIA API key for the Pi coding agent (get one at https://build.nvidia.com/)"
    read -rsp "NVIDIA API key (Enter to skip): " key <"$terminal"
    echo
    if [[ -z "$key" ]]; then
        echo "Skipped."
        exit 0
    fi
fi

if [[ -f "$store" && ! -f "$age_key" ]]; then
    echo "The store $store exists but the age key $age_key is missing." >&2
    echo "Restore the key from your backup. A new key could not read the store." >&2
    exit 1
fi

if [[ ! -f "$store" ]]; then
    if [[ -z "$terminal" ]]; then
        echo "Cannot create the store without a terminal: secrets init asks you to confirm a backup."
        echo "Run later: secrets init && printf %s \"\$NVIDIA_API_KEY\" | secrets set NVIDIA_API_KEY"
        exit 0
    fi
    secrets init <"$terminal"
fi

printf '%s' "$key" | secrets set NVIDIA_API_KEY
echo "NVIDIA_API_KEY stored in the secrets store"
