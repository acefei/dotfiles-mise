#!/usr/bin/env bash
#MISE description="Initialize secrets store (sops+age) and store NVIDIA_API_KEY"
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

echo "Setting up secrets store..."

# Check for NVIDIA_API_KEY in environment (CI/GitHub Actions)
NVIDIA_API_KEY="${NVIDIA_API_KEY:-}"
if [[ -n "$NVIDIA_API_KEY" ]]; then
    echo "NVIDIA_API_KEY found in environment"
else
    # Check if already in secrets store
    if command -v secrets &>/dev/null && secrets list 2>/dev/null | grep -q "NVIDIA_API_KEY"; then
        echo "NVIDIA_API_KEY already in secrets store"
        NVIDIA_API_KEY="$(secrets get NVIDIA_API_KEY 2>/dev/null || true)"
    fi
fi

# If still not found and interactive, prompt
if [[ -z "$NVIDIA_API_KEY" && -t 0 ]]; then
    echo ""
    echo "NVIDIA API key required for Pi Coding Agent (NVIDIA NIM provider)"
    echo "Get one at: https://build.nvidia.com/"
    echo ""
    read -rp "Enter NVIDIA API key (or press Enter to skip): " NVIDIA_API_KEY
fi

# If we have a key, store it
if [[ -n "$NVIDIA_API_KEY" ]]; then
    # Install secrets if not available
    if ! command -v secrets &>/dev/null; then
        echo "Installing secrets (sops+age) via mise..."
        mise install secrets
    fi

    # Initialize secrets store if needed
    if ! secrets list >/dev/null 2>&1; then
        echo "Initializing secrets store (age key will be created)..."
        secrets init
    fi

    # Store the API key
    printf '%s' "$NVIDIA_API_KEY" | secrets set NVIDIA_API_KEY
    echo "NVIDIA_API_KEY stored in secrets"
else
    echo "No NVIDIA_API_KEY provided. Skipping secrets setup."
    echo "Run this task again with NVIDIA_API_KEY set, or manually:"
    echo "  mise install secrets && secrets init && secrets set NVIDIA_API_KEY"
fi