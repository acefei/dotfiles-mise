#!/usr/bin/env bash
#MISE description="Store NVIDIA_API_KEY in the secrets store (sops+age)"
#MISE depends=["setup-utility"]
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

# setup-utility links utility/secrets here; without it the command is not found.
export PATH="$HOME/.local/bin:$PATH"

# CI: the key stays in the environment, where Pi reads it. A store needs an age key
# and a person to confirm its backup; a throw-away runner has neither.
if [[ -n "${CI:-}" ]]; then
    echo "CI: NVIDIA_API_KEY stays in the environment, it is not stored"
    exit 0
fi

key="${NVIDIA_API_KEY:-}"

if [[ -z "$key" ]] && secrets list 2>/dev/null | grep -q "NVIDIA_API_KEY"; then
    echo "NVIDIA_API_KEY is already in the secrets store"
    exit 0
fi

if [[ -z "$key" ]]; then
    if [[ ! -t 0 ]]; then
        echo "No NVIDIA_API_KEY and no terminal to ask on, skipping."
        echo "Run later: mise run setup-secrets"
        exit 0
    fi
    echo "NVIDIA API key for the Pi coding agent (get one at https://build.nvidia.com/)"
    read -rsp "NVIDIA API key (Enter to skip): " key
    echo
    if [[ -z "$key" ]]; then
        echo "Skipped."
        exit 0
    fi
fi

# `secrets init` makes you type BACKED-UP: the age key is the only way to read the store.
# That answer must come from a person, so it needs a terminal.
if ! secrets list >/dev/null 2>&1; then
    if [[ ! -t 0 ]]; then
        echo "Cannot create the store without a terminal: secrets init asks you to confirm a backup."
        echo "Run later: secrets init && printf %s \"\$NVIDIA_API_KEY\" | secrets set NVIDIA_API_KEY"
        exit 0
    fi
    secrets init
fi

printf '%s' "$key" | secrets set NVIDIA_API_KEY
echo "NVIDIA_API_KEY stored in the secrets store"
