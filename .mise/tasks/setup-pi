#!/usr/bin/env bash
#MISE description="Configure Pi Coding Agent (settings, NVIDIA provider via secrets)"
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

PI_AGENT_DIR="$HOME/.pi/agent"

echo "Setting up Pi Coding Agent..."

# Ensure Pi agent directory exists
install -d "$PI_AGENT_DIR"

# Check for NVIDIA API key via secrets (set during install or manually)
NVIDIA_API_KEY="${NVIDIA_API_KEY:-}"
if [[ -z "$NVIDIA_API_KEY" ]]; then
    if command -v secrets &>/dev/null && secrets list 2>/dev/null | grep -q "NVIDIA_API_KEY"; then
        echo "NVIDIA_API_KEY found in secrets store"
        NVIDIA_API_KEY="$(secrets get NVIDIA_API_KEY 2>/dev/null || true)"
    fi
fi

if [[ -z "$NVIDIA_API_KEY" ]]; then
    echo ""
    echo "NVIDIA API key not found in environment or secrets."
    echo "Get one at: https://build.nvidia.com/"
    echo ""
    read -rp "Enter NVIDIA API key (or press Enter to skip): " NVIDIA_API_KEY
    if [[ -n "$NVIDIA_API_KEY" ]]; then
        if command -v secrets &>/dev/null; then
            printf '%s' "$NVIDIA_API_KEY" | secrets set NVIDIA_API_KEY
            echo "Stored in secrets"
        else
            export NVIDIA_API_KEY
            echo "Set for current session (export NVIDIA_API_KEY)"
        fi
    fi
fi

# Generate settings.json with NVIDIA models
SETTINGS_FILE="$PI_AGENT_DIR/settings.json"
cat > "$SETTINGS_FILE" << 'EOF'
{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "nvidia",
  "enabledModels": [
    "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
    "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b",
    "nvidia/nemotron-3.5-lightning",
    "nvidia/z-ai/glm-5.3-flash",
    "nvidia/poolside/laguna-xs-2.1",
    "nvidia/minimaxai/minimax-m3.1-flash"
  ],
  "defaultTools": ["+codemode"],
  "hideThinkingBlock": false
}
EOF

echo "Generated settings.json with NVIDIA models"

# Check if Pi is installed
if command -v pi &>/dev/null; then
    echo "Pi is installed: $(pi --version)"
else
    echo "Pi not installed. Install with: curl -fsSL https://pi.dev/install.sh | sh"
fi

echo "Pi setup complete!"
echo ""
echo "To run Pi with NVIDIA credentials from secrets:"
echo "  secrets exec -- pi"
echo ""
echo "Then in Pi: /login -> select nvidia"