#!/usr/bin/env bash
#MISE description="Configure the Pi coding agent (NVIDIA provider) and test the configured models"
#MISE depends=["setup-secrets"]
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

PI_AGENT_DIR="$HOME/.pi/agent"
PI_SEED="$MISE_PROJECT_ROOT/agents/pi/settings.json"

install_pi() {
    if command -v pi &>/dev/null; then
        return 0
    fi
    echo "Pi not installed. Installing..."
    curl -fsSL https://pi.dev/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
}

# Pi rewrites settings.json from its own commands (/model, /settings), so the repo
# files are seeds: copy them once and never overwrite what Pi or you changed.
# models.json adds the models that Pi's built-in catalog does not have yet.
seed_settings() {
    install -d "$PI_AGENT_DIR"
    copy_once "$PI_SEED" "$PI_AGENT_DIR/settings.json"
    copy_once "$MISE_PROJECT_ROOT/agents/pi/models.json" "$PI_AGENT_DIR/models.json"
}

# Test every model in enabledModels of the seed, so the list in the repo is the list
# that works. Pi reads the key from the environment (CI) or from the secrets store.
# Without a key there is nothing to test, so skip: a machine that only wants its
# dotfiles must not fail because it has no key.
check_models() {
    local run=()
    if [[ -n "${NVIDIA_API_KEY:-}" ]]; then
        echo "Testing the configured NVIDIA models (key from the environment)..."
    elif command -v secrets &>/dev/null && secrets get NVIDIA_API_KEY &>/dev/null; then
        echo "Testing the configured NVIDIA models (key from the secrets store)..."
        run=(secrets exec --)
    else
        echo "No NVIDIA_API_KEY in the environment or the secrets store, skipping the model tests."
        echo "Add one with: mise run setup-secrets"
        return 0
    fi
    if ! command -v jq &>/dev/null; then
        echo "jq not installed, skipping the model tests"
        return 0
    fi

    local model passed=0 failed=0 failures=""
    while IFS= read -r model; do
        echo "--- $model"
        # One question per model, at the thinking level of the seed settings.
        # </dev/null: pi -p waits on stdin when it is not a terminal.
        if ${run[@]+"${run[@]}"} pi -p "Reply with OK." --no-session --model "$model" --thinking high </dev/null; then
            echo "PASS $model"
            passed=$((passed + 1))
        else
            echo "FAIL $model"
            failed=$((failed + 1))
            failures="$failures $model"
        fi
    done < <(jq -r '.enabledModels[]' "$PI_SEED")

    echo "Model tests: $passed passed, $failed failed"
    if [[ $failed -gt 0 ]]; then
        echo "Failed:$failures" >&2
        return 1
    fi
}

echo "Setting up the Pi coding agent..."
install_pi
echo "Pi is installed: $(pi --version)"
seed_settings
check_models
echo "Pi setup complete"
