#!/usr/bin/env bash
#MISE description="Configure Pi Coding Agent (settings, NVIDIA provider) and run Pi"
#MISE depends=["setup-secrets"]
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

PI_AGENT_DIR="$HOME/.pi/agent"

echo "Setting up Pi Coding Agent..."

# Ensure Pi agent directory exists
install -d "$PI_AGENT_DIR"

# Generate settings.json with NVIDIA models
SETTINGS_FILE="$PI_AGENT_DIR/settings.json"
cat > "$SETTINGS_FILE" << 'EOF'
{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "nvidia",
  "enabledModels": [
    "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
    "nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b",
    "nvidia/nemotron-3.5-lightning",
    "nvidia/z-ai/glm-5.3-flash",
    "nvidia/poolside/laguna-xs-2.1",
    "nvidia/minimaxai/minimax-m3.1-flash"
  ],
  "defaultTools": ["+codemode"],
  "hideThinkingBlock": false
}
EOF

echo "Generated settings.json with NVIDIA models"

# Check if Pi is installed
if command -v pi &>/dev/null; then
    echo "Pi is installed: $(pi --version)"
else
    echo "Pi not installed. Install with: curl -fsSL https://pi.dev/install.sh | sh"
    exit 1
fi

# Run Pi with secrets (validates model works)
# In CI: runs once and exits (-p flag)
# Interactive: would start full session, but we use -p for validation
echo ""
echo "Validating NVIDIA model via Pi..."
secrets exec -- pi -p "Say 'OK' if NVIDIA model responds"
echo "Pi validation complete!"