#!/usr/bin/env bash
#MISE description="Configure Herdr and connect it to Claude Code and Pi"
#MISE depends=["setup-agents"]
set -euo pipefail
source "$MISE_PROJECT_ROOT/lib/utils.sh"

if ! command -v herdr &>/dev/null; then
    echo "herdr not found. Run: mise install" >&2
    [[ "${CI:-}" != "true" ]]
    exit $?
fi

herdr_config="$HOME/.config/herdr/config.toml"
repo_config="$MISE_PROJECT_ROOT/config/herdr/config.toml"

install -d "$HOME/.config/herdr"
if [[ -L "$herdr_config" && "$(readlink "$herdr_config")" == "$repo_config" ]]; then
    echo "$herdr_config links to the repo; replacing the link with a copy of its content"
    kept=$(mktemp)
    cp "$repo_config" "$kept"
    rm "$herdr_config"
    install -m 644 "$kept" "$herdr_config"
    rm -f "$kept"
    git -C "$MISE_PROJECT_ROOT" checkout -- config/herdr/config.toml \
        || echo "Could not restore $repo_config: run git checkout -- config/herdr/config.toml"
fi
copy_once "$repo_config" "$herdr_config"
herdr config check </dev/null

install -d "$HOME/.pi/agent/extensions" "$HOME/.claude"
for agent in pi claude; do
    if command -v "$agent" &>/dev/null; then
        echo "Connecting Herdr to $agent"
        herdr integration install "$agent" </dev/null
    else
        echo "$agent not installed, skipping its Herdr integration"
    fi
done
echo "Herdr ready. Start it with: herdr"
