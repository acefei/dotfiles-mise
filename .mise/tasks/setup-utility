#!/usr/bin/env bash
#MISE description="Symlink utility scripts into ~/.local/bin"
set -euo pipefail

install -d "$HOME/.local/bin"

# Symlinked, not copied, so edits in the repo take effect immediately.
for cmd in "$MISE_PROJECT_ROOT"/utility/*; do
    [[ -e "$cmd" ]] || continue
    ln -sfn "$cmd" "$HOME/.local/bin/$(basename "$cmd")"
done
