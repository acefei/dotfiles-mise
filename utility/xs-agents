#!/usr/bin/env bash
# xs-agents — one Herdr workspace per task, each with its own git worktree and branch,
# an AI agent in the first pane and a shell for builds in the second.
#
#   xs-agents [-k pi|claude] [-r REPO] BRANCH [BRANCH...]
#
# Run it from a shell inside Herdr (or after starting `herdr` once: the server must run).
# Herdr puts the worktrees under ~/.herdr/worktrees. Remove one with `herdr worktree remove`.
set -euo pipefail

kind=claude
repo=$PWD

usage() {
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -k) kind=${2:?-k needs pi or claude}; shift 2 ;;
        -r) repo=${2:?-r needs a path}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done
[[ $# -gt 0 ]] || { usage >&2; exit 2; }

for cmd in herdr jq git; do
    command -v "$cmd" &>/dev/null || { echo "$cmd not found. Run: mise install" >&2; exit 1; }
done
git -C "$repo" rev-parse --git-dir &>/dev/null || { echo "$repo is not a git repository" >&2; exit 1; }
if ! herdr status server 2>/dev/null | grep -q 'status: running'; then
    echo "No Herdr server is running. Start it first with: herdr" >&2
    exit 1
fi

for branch in "$@"; do
    label=${branch##*/}
    created=$(herdr worktree create --cwd "$repo" --branch "$branch" --label "$label" --no-focus)
    pane=$(jq -er '.result.root_pane.pane_id' <<<"$created") \
        || { echo "Could not create a worktree workspace for $branch: $created" >&2; exit 1; }
    herdr pane split --pane "$pane" --direction right --no-focus >/dev/null
    herdr agent start "$label" --kind "$kind" --pane "$pane"
    echo "$branch: $kind running in workspace $label"
done
